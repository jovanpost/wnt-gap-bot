# Copy to .env for local runs. On Streamlit Cloud use Secrets.
# Never commit real keys. Public repo.

# --- mode ---
PAPER=true
LIVE_TRADING=false
DRY_RUN=true

# --- Kalshi (same key as no-fade is fine; different client_order_id namespace later) ---
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PEM="""
-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----
"""
USE_DEMO=false

# --- Supabase (SAME project as no-fade, different tables) ---
# Use the pooler URL. If :6543 ECONNREFUSED, switch port to :5432 on the same host.
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Telegram (NEW bot — do not reuse no-fade commands) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- strategy freeze ---
GAP_THRESHOLD=15
NOTIONAL_DOLLARS=5.00
CLUSTER_CAP=2
NIGHT_CAP_FRACTION=0.20
PROMPT_VERSION=gap-v1.0
JSON_DEADLINE_CT=16:30
POLL_START_CT=11:00
MARKET_OPEN_CT=10:00
DECISION_LAG_MIN=60
CANCEL_AFTER_MIN=60
SERIES=KXWORLDNEWSMENTION
