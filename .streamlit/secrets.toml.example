# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud → App settings → Secrets.
# Public repo — never commit the real file.

PAPER = true
LIVE_TRADING = false
DRY_RUN = true
USE_DEMO = false

SERIES = "KXWORLDNEWSMENTION"
GAP_THRESHOLD = "15"
NOTIONAL_DOLLARS = "5.00"
CLUSTER_CAP = "2"
NIGHT_CAP_FRACTION = "0.20"
BANKROLL_DOLLARS = "150.00"
PROMPT_VERSION = "gap-v1.0"
JSON_DEADLINE_CT = "16:30"
POLL_START_CT = "11:00"
MARKET_OPEN_CT = "10:00"
DECISION_LAG_MIN = "60"
CANCEL_AFTER_MIN = "60"

KALSHI_KEY_ID = "your-key-id"
KALSHI_PRIVATE_KEY_PEM = """
-----BEGIN RSA PRIVATE KEY-----
paste
-----END RSA PRIVATE KEY-----
"""

DATABASE_URL = "postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

TELEGRAM_TOKEN = "123456:ABC..."
TELEGRAM_CHAT_ID = "your-numeric-chat-id"
TELEGRAM_COMMANDS = true
