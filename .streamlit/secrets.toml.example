# Copy to Streamlit Cloud → App settings → Secrets.
# Public repo — never commit the real file.

PAPER = true
LIVE_TRADING = false
DRY_RUN = true
USE_DEMO = false

SERIES = "KXWORLDNEWSMENTION"
GAP_THRESHOLD = "15"
PROMPT_VERSION = "gap-v1.0"
JSON_DEADLINE_CT = "16:30"
POLL_START_CT = "07:00"
MARKET_OPEN_CT = "10:00"
DECISION_LAG_MIN = "60"
CANCEL_AFTER_MIN = "60"

# Same REAL Kalshi key wnt-nofade-bot already trades live with -- not a second
# account. gap-bot needs its own copy of it here so Book L can place its own
# (much smaller) real orders through the same signed-request path.
KALSHI_KEY_ID = "your-key-id"
KALSHI_PRIVATE_KEY_PEM = """
-----BEGIN RSA PRIVATE KEY-----
paste
-----END RSA PRIVATE KEY-----
"""
ORDER_API = "v2"
POST_ONLY = true
USE_SERVER_SIDE_EXPIRY = true

DATABASE_URL = "postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

TELEGRAM_TOKEN = "123456:ABC..."
TELEGRAM_CHAT_ID = "your-numeric-chat-id"
TELEGRAM_COMMANDS = true

# --- Book L: LIVE real-money trading -----------------------------------
# L_LIVE_ON is a hard kill switch. Leave it false until you've read the L
# tab in the app and are ready for real orders. Everything below it is
# frozen once L_LIVE_ON is turned on for the first time -- do not tune
# before 30 filled trades or 6 weeks (see gap/config.py's comment).
L_LIVE_ON = false
L_NOTIONAL_DOLLARS = "10"
L_NIGHTLY_CAP_DOLLARS = "50"
L_MAX_WORDS_PER_NIGHT = "5"
L_CIRCUIT_BREAKER_WEEKLY_LOSS = "30"
L_CANCEL_AFTER_MIN = "60"
